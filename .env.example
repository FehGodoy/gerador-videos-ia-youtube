# Copie este arquivo para ".env" e preencha com suas chaves reais.
# Nunca commite o ".env" de verdade (já está no .gitignore).

# Cartesia (Text-to-Speech) - https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# Busca de footage (gratuitas)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# LLM para extração de keywords visuais (passo 3).
# Defina o provider em config.yaml (anthropic | openai) e preencha a chave correspondente.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
